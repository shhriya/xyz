# Copy to backend/.env and fill in. Never commit backend/.env.

# ── Application database (PostgreSQL, required) ──────────────────────────────
# The team shares one Neon database. `neon link` (see README) writes these to ../.env.local.
# Without the Neon CLI, get both URLs from a teammate and uncomment them here (never commit them).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Seed the demo project (sample Informatica/PySpark metadata) into an empty database
SEED_DEMO_DATA=true

# Encrypts saved credentials in the database. Everyone sharing the database MUST use the same key
# (get it from a teammate). Only for a brand-new database, generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Snowflake ────────────────────────────────────────────────────────────────
# Optional key-pair fallback for the CFO AI analyst. Keep the .p8 file outside the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Optional dedicated read-only user/role for the governance chatbot
GOV_CHATBOT_SF_USER=
GOV_CHATBOT_SF_PASSWORD=
GOV_CHATBOT_ROLE=

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed by CORS ("*" allows any; restrict in production)
CORS_ORIGINS=*
# Where generated dbt projects are written (defaults: <repo>/dbt_output and <repo>/dbt_cloud_modernization)
# DBT_PROJECT_DIR=
# CLOUD_MOD_PROJECT_DIR=
